{"slug": "repo-fall2025-week4-assignmentmd", "id": "repo-fall2025-week4-assignmentmd#b0045-i00", "block": 45, "kind": "list_item", "translate": true, "chars": 32, "sha256": "59a47705524cc9b5", "text": "Example 1: TestAgent + CodeAgent"}
