{"slug": "repo-fall2025-week4-assignmentmd", "id": "repo-fall2025-week4-assignmentmd#b0045-i02", "block": 45, "kind": "list_item", "translate": true, "chars": 32, "sha256": "8cf6d8ab61e03f00", "text": "Example 2: DocsAgent + CodeAgent"}
